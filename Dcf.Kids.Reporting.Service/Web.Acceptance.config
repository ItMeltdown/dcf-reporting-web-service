<?xml version="1.0"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
   <db2Connection>
      <add name="db2Connection" providerName="IBM.Data.DB2" connectionString="Database=D00A;DbOwnerPrefix=PWA481TC.;UID=dcfkrpta;PWD=${db2SecurePassword:Password}" xdt:Transform="SetAttributes" xdt:Locator="Match(name)"/>
   </db2Connection>

   <configProtectedData>
      <providers>
         <add name="SecureProvider" SubjectName="CN=EntSec" IssuerName="CN=EntSecCA" StoreName="My" xdt:Transform="SetAttributes" xdt:Locator="Match(name)"/>
      </providers>
   </configProtectedData>

   <db2SecurePassword configProtectionProvider="SecureProvider" xdt:Transform="Replace">
      <EncryptedData Type="http://www.w3.org/2001/04/xmlenc#Element" xmlns="http://www.w3.org/2001/04/xmlenc#">
         <EncryptionMethod Algorithm="http://www.w3.org/2001/04/xmlenc#aes256-cbc" xmlns="http://www.w3.org/2001/04/xmlenc#" />
         <KeyInfo xmlns="http://www.w3.org/2000/09/xmldsig#">
            <EncryptedKey xmlns="http://www.w3.org/2001/04/xmlenc#">
               <EncryptionMethod Algorithm="http://www.w3.org/2001/04/xmlenc#rsa-1_5" />
               <KeyInfo xmlns="http://www.w3.org/2000/09/xmldsig#">
                  <X509Data>
                     <X509Certificate></X509Certificate>
                  </X509Data>
               </KeyInfo>
               <CipherData>
                  <CipherValue></CipherValue>
               </CipherData>
            </EncryptedKey>
         </KeyInfo>
         <CipherData xmlns="http://www.w3.org/2001/04/xmlenc#">
            <CipherValue>q/c+tDFXWJ91iGAz9hbmgV7hEDFB/SR1kjDHzq0SkUqTPtfUxHo+nsil1E4qQvip/Bjbp0iTcjbCj5uQTRoPNpLvtT6tg3QXZxWEAZncixKrxLoxEZ/Eh/L6tiUvJrzj</CipherValue>
         </CipherData>
      </EncryptedData>
   </db2SecurePassword>

   <system.web>
      <compilation xdt:Transform="RemoveAttributes(debug)" />
   </system.web>

   <system.serviceModel>
      <services>
         <service name="Dcf.Kids.Reporting.Service.CrystalService">
            <host>
               <baseAddresses xdt:Transform="Replace">
                  <add baseAddress="https://kidsreportingacc.wisconsin.gov"/>
               </baseAddresses>
            </host>
            <endpoint address="" xdt:Transform="Remove" xdt:Locator="Match(address)"/>
            <endpoint address="mex" xdt:Transform="Remove" xdt:Locator="Match(address)"/>
            <endpoint address="" binding="basicHttpsBinding" contract="Dcf.Kids.Reporting.Service.ICrystalService" bindingConfiguration="basicHttpsBinding_ICrystalService" xdt:Transform="Insert" />
            <endpoint address="mex" binding="mexHttpsBinding" contract="IMetadataExchange" xdt:Transform="Insert"/>
         </service>
      </services>
      <bindings>
         <basicHttpBinding xdt:Transform="Remove" />
         <basicHttpsBinding xdt:Transform="Insert">
            <binding name="basicHttpsBinding_ICrystalService">
               <security mode="Transport">
                  <transport clientCredentialType="Basic" />
               </security>
            </binding>
         </basicHttpsBinding>
      </bindings>
   </system.serviceModel>

   <location path="elmah" xdt:Locator="Match(path)">
      <system.web>
         <authorization xdt:Transform="Remove" />
         <authorization xdt:Transform="Insert">
            <allow roles="DCFINT\DMS_BITS_KIDS" xdt:Transform="SetAttributes(roles)"/>
            <deny users="*"/>
         </authorization>
      </system.web>
   </location>

   <elmah>
      <errorLog logPath="\\dcfint.wistate.us\Proc\KIDS\acc\Logs\Service\KidsReporting" xdt:Transform="SetAttributes(logPath)" />
   </elmah>

   <appSettings>
      <add key="DistributionLocationReports" value="E:\Inetpub\wwwroot\KidsReportingAcc.wisconsin.gov\Distribution\" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
      <add key="LocalServiceLocation" value="E:\Inetpub\wwwroot\KidsReportingAcc.wisconsin.gov\ServiceWorkingFolder\" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
      <add key="TemplateFileLocationReports" value="\\dcfint.wistate.us\Proc\KIDS\acc\KidsReporting\Templates\" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
      <add key="DbOwnerPrefix" value="PWA481TC" xdt:Transform="SetAttributes" xdt:Locator="Match(key)"/>
   </appSettings>
</configuration>