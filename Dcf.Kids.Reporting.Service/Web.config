<?xml version="1.0" encoding="utf-8"?>
<configuration>
   <configSections>
      <section name="db2SecurePassword" type="DCF.Enterprise.CertificateEncryption.KeyValueSectionHandler, DCF.Enterprise.CertificateEncryption, Version=1.0.0.29270, Culture=neutral, PublicKeyToken=51085a37f3b10160" />
      <section name="db2Connection" type="DCF.Enterprise.CertificateEncryption.ConfigSectionHandler, DCF.Enterprise.CertificateEncryption, Version=1.0.0.29270, Culture=neutral, PublicKeyToken=51085a37f3b10160" />
      <sectionGroup name="elmah">
         <section name="security" requirePermission="false" type="Elmah.SecuritySectionHandler, Elmah" />
         <section name="errorLog" requirePermission="false" type="Elmah.ErrorLogSectionHandler, Elmah" />
         <section name="errorMail" requirePermission="false" type="Elmah.ErrorMailSectionHandler, Elmah" />
         <section name="errorFilter" requirePermission="false" type="Elmah.ErrorFilterSectionHandler, Elmah" />
      </sectionGroup>
   </configSections>
   <!--This is how you define a connection string section that cross-references a value from a different 
     encryption section.  From what I can tell, this only supports one connection string.  Note the use of
     the ${} markup to reference the section and key of the value that should be replaced here.
   -->
   <db2Connection>
      <add name="db2Connection" providerName="IBM.Data.DB2" connectionString="Database=D00D;UID=dcfkrptd;PWD=${db2SecurePassword:Password}" />
   </db2Connection>
   <configProtectedData>
      <providers>
         <add name="SecureProvider" SubjectName="CN=EntSecDev" IssuerName="CN=EntSecDevCA" StoreName="My" type="DCF.Enterprise.CertificateEncryption.SecureConfigProvider, DCF.Enterprise.CertificateEncryption, Version=1.0.0.29270, Culture=neutral, PublicKeyToken=51085a37f3b10160" />
      </providers>
   </configProtectedData>
   <!--Kids Reporting
   DB2 User: DCFKRPTD (D00D)

   <db2SecurePassword>
      <add key="Password" value=""/>
   </db2SecurePassword>-->
   <!--Encrypted-->
   <db2SecurePassword configProtectionProvider="SecureProvider">
      <EncryptedData Type="http://www.w3.org/2001/04/xmlenc#Element" xmlns="http://www.w3.org/2001/04/xmlenc#">
         <EncryptionMethod Algorithm="http://www.w3.org/2001/04/xmlenc#aes256-cbc" />
         <KeyInfo xmlns="http://www.w3.org/2000/09/xmldsig#">
            <EncryptedKey xmlns="http://www.w3.org/2001/04/xmlenc#">
               <EncryptionMethod Algorithm="http://www.w3.org/2001/04/xmlenc#rsa-1_5" />
               <KeyInfo xmlns="http://www.w3.org/2000/09/xmldsig#">
                  <X509Data>
                     <X509Certificate></X509Certificate>
                  </X509Data>
               </KeyInfo>
               <CipherData>
                  <CipherValue></CipherValue>
               </CipherData>
            </EncryptedKey>
         </KeyInfo>
         <CipherData>
            <CipherValue>iLcHOgk1+84P4/W7YYEKAOR6+gbaGPw9gvj1z2/DAcY7G7anRXtw1mFrUQLah9mfRZyPsbSwfV4UCs39q80CnuHULWwVS2RyPtEjSxq4OFVb6EOoKjU5N05LNmOxirv0</CipherValue>
         </CipherData>
      </EncryptedData>
   </db2SecurePassword>
   <!--CN=EntSecDev & CN=EntSecDevCA-->
   <!--
    For a description of web.config changes see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web>
        <httpRuntime targetFramework="4.8" />
      </system.Web>
  -->
   <system.web>
      <compilation debug="true" targetFramework="4.8" />
      <customErrors mode="Off" />
      <httpRuntime targetFramework="4.8" />
      <sessionState mode="Off" />
      <pages controlRenderingCompatibilityVersion="4.0" />
      <httpModules>
         <add name="ErrorLog" type="Elmah.ErrorLogModule, Elmah" />
         <add name="ErrorMail" type="Elmah.ErrorMailModule, Elmah" />
         <add name="ErrorFilter" type="Elmah.ErrorFilterModule, Elmah" />
      </httpModules>
   </system.web>
   <system.serviceModel>
      <services>
         <service name="Dcf.Kids.Reporting.Service.CrystalService">
            <host>
               <baseAddresses>
                  <add baseAddress="http://localhost:25011" />
               </baseAddresses>
            </host>
            <endpoint address="" binding="basicHttpBinding" contract="Dcf.Kids.Reporting.Service.ICrystalService" bindingConfiguration="basicHttpBinding_ICrystalService" />
            <endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange" />
         </service>
      </services>
      <bindings>
         <basicHttpBinding>
            <binding name="basicHttpBinding_ICrystalService">
               <security mode="None" />
            </binding>
         </basicHttpBinding>
      </bindings>
      <behaviors>
         <serviceBehaviors>
            <behavior>
               <serviceMetadata httpGetEnabled="true" httpsGetEnabled="true" />
               <serviceDebug includeExceptionDetailInFaults="true" />
            </behavior>
         </serviceBehaviors>
      </behaviors>
      <serviceHostingEnvironment aspNetCompatibilityEnabled="true" />
   </system.serviceModel>
   <location path="elmah">
      <system.web>
         <httpHandlers>
            <add verb="POST,GET,HEAD" path="elmah" type="Elmah.ErrorLogPageFactory, Elmah" />
         </httpHandlers>
         <authorization>           
            <allow users="*" />
         </authorization>
      </system.web>
      <system.webServer>
         <handlers>
            <add name="ELMAH" verb="POST,GET,HEAD" path="elmah" type="Elmah.ErrorLogPageFactory, Elmah" preCondition="integratedMode" />
         </handlers>
      </system.webServer>
   </location>
   <system.webServer>
      <validation validateIntegratedModeConfiguration="false" />
      <modules>
         <add name="ErrorLog" type="Elmah.ErrorLogModule, Elmah" preCondition="managedHandler" />
         <add name="ErrorMail" type="Elmah.ErrorMailModule, Elmah" preCondition="managedHandler" />
         <add name="ErrorFilter" type="Elmah.ErrorFilterModule, Elmah" preCondition="managedHandler" />
      </modules>
   </system.webServer>
   <appSettings>
      <add key="DistributionLocationReports" value="\\dcfint.wistate.us\Proc\KIDS\dev\KidsReporting\Distribution\" />
      <add key="LocalServiceLocation" value="\\dcfint.wistate.us\Proc\KIDS\dev\KidsReporting\ServiceWorkingFolder\" />
      <add key="TemplateFileLocationReports" value="\\dcfint.wistate.us\Proc\KIDS\dev\KidsReporting\Templates" />
      <add key="DbOwnerPrefix" value="PWD481TC" />
      <add key="DefaultLanguageCode" value="en" />
   </appSettings>
   <elmah>
      <errorLog type="Elmah.XmlFileErrorLog, Elmah" logPath="~/Logs" />
      <security allowRemoteAccess="true" />
   </elmah>
   <runtime>
      <AppContextSwitchOverrides value="Switch.System.Net.DontEnableSchSendAuxRecord=true" />
   </runtime>
  
</configuration>