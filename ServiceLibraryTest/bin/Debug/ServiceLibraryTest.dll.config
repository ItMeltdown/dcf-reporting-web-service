<?xml version="1.0" encoding="utf-8"?>
<configuration>
   <configSections>
      <section name="db2SecurePassword" type="DCF.Enterprise.CertificateEncryption.KeyValueSectionHandler, DCF.Enterprise.CertificateEncryption, Version=1.0.0.29270, Culture=neutral, PublicKeyToken=51085a37f3b10160"/>
      <section name="db2Connection" type="DCF.Enterprise.CertificateEncryption.ConfigSectionHandler, DCF.Enterprise.CertificateEncryption, Version=1.0.0.29270, Culture=neutral, PublicKeyToken=51085a37f3b10160"/>
      <sectionGroup name="elmah">
         <section name="security" requirePermission="false" type="Elmah.SecuritySectionHandler, Elmah"/>
         <section name="errorLog" requirePermission="false" type="Elmah.ErrorLogSectionHandler, Elmah"/>
         <section name="errorMail" requirePermission="false" type="Elmah.ErrorMailSectionHandler, Elmah"/>
         <section name="errorFilter" requirePermission="false" type="Elmah.ErrorFilterSectionHandler, Elmah"/>
      </sectionGroup>
   </configSections>
   <db2Connection>
      <add name="db2Connection" providerName="IBM.Data.DB2" connectionString="Database=D00D;DbOwnerPrefix=PWD481TC.;UID=dwdktfd;PWD=${db2SecurePassword:Password}"/> 
   </db2Connection>
   <configProtectedData>
      <providers>
         <add name="SecureProvider" SubjectName="CN=EntSecDev" IssuerName="CN=EntSecDevCA" StoreName="My" type="DCF.Enterprise.CertificateEncryption.SecureConfigProvider, DCF.Enterprise.CertificateEncryption, Version=1.0.0.29270, Culture=neutral, PublicKeyToken=51085a37f3b10160"/>
      </providers>
   </configProtectedData>

   <!--This demonstrates how you can decrypt a single name-value pair using custom FSE configuration section class.
     This is the approach that FSE recommends for a single password value.  In addition, you need to use this class
     if you want to cross-reference the value using the ${} markup below.
     NOTE: The same code will parse the contained value whether it's encrypted or not.
     The section encrypted here is:
     <db2SecurePassword>
       <add key="Password" value="MyDB2ConnectionPassword" />
     </db2SecurePassword>
   -->
   <db2SecurePassword configProtectionProvider="SecureProvider">
      <EncryptedData Type="http://www.w3.org/2001/04/xmlenc#Element" xmlns="http://www.w3.org/2001/04/xmlenc#">
         <EncryptionMethod Algorithm="http://www.w3.org/2001/04/xmlenc#aes256-cbc" xmlns="http://www.w3.org/2001/04/xmlenc#"/>
         <KeyInfo xmlns="http://www.w3.org/2000/09/xmldsig#">
            <EncryptedKey xmlns="http://www.w3.org/2001/04/xmlenc#">
               <EncryptionMethod Algorithm="http://www.w3.org/2001/04/xmlenc#rsa-1_5"/>
               <KeyInfo xmlns="http://www.w3.org/2000/09/xmldsig#">
                  <X509Data>
                     <X509Certificate></X509Certificate>
                  </X509Data>
               </KeyInfo>
               <CipherData>
                  <CipherValue></CipherValue>
               </CipherData>
            </EncryptedKey>
         </KeyInfo>
         <CipherData xmlns="http://www.w3.org/2001/04/xmlenc#">
            <CipherValue>C6mQWjc/47GJcZEjvgND0CfLGCDBdCxQt/tRzySPArOiQDkd8PgpupIYqiEEQbxgQsA9KLVid8Ei/cwcNj+xf1Wld5yMQsn5zv4tpgrRjtsl6/Q4GsIhhzI7VmprqmH/</CipherValue>
         </CipherData>
      </EncryptedData>
   </db2SecurePassword>

   <appSettings>
      <add key="DistributionLocationReports" value="\\dcfint.wistate.us\Proc\KIDS\dev\KidsReporting\Distribution\"/>
      <add key="TemplateFileLocationReports" value="\\dcfint.wistate.us\Proc\KIDS\dev\KidsReporting\Templates\"/>
      <add key="LocalServiceLocation" value="\\dcfint.wistate.us\Proc\KIDS\dev\KidsReporting\ServiceWorkingFolder\"/>
   </appSettings>
   <system.serviceModel>
      <bindings>
         <basicHttpBinding>
            <binding name="basicHttpBinding_ICrystalService" maxReceivedMessageSize="1000000">
               <security mode="None"/>
            </binding>
         </basicHttpBinding>
      </bindings>
      <client>
         <endpoint address="http://localhost:25011/CrystalService.svc" binding="basicHttpBinding" bindingConfiguration="basicHttpBinding_ICrystalService" contract="CrystalServiceLocal.ICrystalService" name="basicHttpBinding_ICrystalService"/>
      </client>
   </system.serviceModel>
<startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/></startup></configuration>
